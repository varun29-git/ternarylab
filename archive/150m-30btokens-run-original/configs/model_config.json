{
  "vocab_size": 32000,
  "dim": 768,
  "n_layers": 20,
  "n_heads": 12,
  "n_kv_heads": 4,
  "ffn_dim": 2048,
  "alpha_floor": 0.05,
  "max_seq_len": 4096,
  "rms_norm_eps": 1e-05,
  "rope_theta": 10000.0,
  "dropout": 0.0,
  "pad_token_id": null,
  "weight_init": "orthogonal",
  "alpha_group_size": 128,
  "attention_backend": "fa3",
  "use_subln": true,
  "ffn_activation": "swiglu",
  "use_embedding_projection": false,
  "quantization_strength": 1.0,
  "residual_init_scale": 1.0,
  "gradient_checkpointing": false,
  "local_attention_window": 1024,
  "global_attention_every": 5,
  "qk_norm_mode": "unit_rms"
}
