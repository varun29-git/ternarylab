{
  "model": {
    "vocab_size": 68096,
    "dim": 2048,
    "n_layers": 30,
    "n_heads": 16,
    "n_kv_heads": 4,
    "ffn_dim": 5376,
    "max_seq_len": 4096,
    "local_attention_window": 512,
    "global_attention_every": 5,
    "attention_backend": "fa3",
    "weight_init": "normal",
    "pad_token_id": null,
    "gradient_checkpointing": true,
    "loss_chunk_size": 256,
    "residual_init_scale": 0.12909944487358055,
    "quantize_activations": true,
    "weight_scale_layout": "blockwise",
    "linear_backend": "deepgemm",
    "fp8_backward": "dgrad",
    "fp8_quantizer": "triton",
    "fp8_cache_weights": true
  },
  "training": {
    "device": "cuda",
    "dtype": "bf16",
    "development_mode": false,
    "gradient_accumulation_steps": 8,
    "warmup_tokens": 300000000,
    "final_lr_fraction": 0.1,
    "grad_clip": 1.0,
    "checkpoint_interval": 500,
    "validation_interval": 500,
    "validation_batches_per_language": 8,
    "log_interval": 10,
    "compile": false
  },
  "optimizer": {
    "kind": "adamw",
    "adamw_lr": 0.0003,
    "norm_lr": 0.0001,
    "weight_decay": 0.1,
    "eps": 1e-08
  }
}
