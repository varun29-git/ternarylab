{
  "vocab_size": 32000,
  "dim": 768,
  "n_layers": 20,
  "n_heads": 12,
  "n_kv_heads": 4,
  "ffn_dim": 2048,
  "expand": 2,
  "alpha_floor": 0.05,
  "max_seq_len": 4096,
  "rms_norm_eps": 1e-05,
  "rope_theta": 10000.0,
  "dropout": 0.0,
  "pad_token_id": null,
  "activation_bits": 8,
  "weight_init": "orthogonal",
  "alpha_init": "absmean",
  "alpha_mode": "deterministic_grouped_absmean",
  "transformer_alpha_mode": "deterministic_grouped_absmean",
  "alpha_group_size": 128,
  "gate_prenorm": true,
  "attention_backend": "fa3",
  "use_subln": true,
  "ffn_activation": "swiglu",
  "use_embedding_projection": false,
  "quantize_activations": false,
  "loss_chunk_size": 16384,
  "quantization_strength": 1.0,
  "residual_init_scale": 1.0,
  "gradient_checkpointing": false,
  "transformer_layer_indices": "all",
  "local_attention_window": 1024,
  "global_attention_every": 5,
  "qk_norm_mode": "unit_rms",
  "attention_temperature_mode": "none",
  "attention_temperature_min": 0.5,
  "attention_temperature_max": 2.0,
  "attention_temperature_init": 1.0,
  "attention_softcap": 0.0,
  "attention_stats_mode": "sampled",
  "attention_stats_sample_seq_len": 256,
  "attention_stats_query_tile_size": 128,
  "require_shard_aligned_alpha_groups": false
}
